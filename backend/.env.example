# ==============================================================================
# VESTRA AI Virtual Try-On Platform - Backend Environment Variables
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Connection Configuration (used by pg Pool)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vestra_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vestra_db

# Admin Authentication
JWT_SECRET=vestra_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=24h

# Virtual Try-On Provider Adapter
# Options: 'genlook' (Official Genlook Try-On API) | 'replicate' | 'mock'
TRYON_PROVIDER=genlook

# Official Genlook Virtual Try-On API Configuration
# Documentation: https://genlook.app/docs/tryon-api/introduction
GENLOOK_API_KEY=
GENLOOK_API_BASE=https://api.genlook.app/tryon/v1
GENLOOK_ENABLED=false
GENLOOK_MOCK=true

# Replicate Cloud Hosted AI Inference Configuration (Secondary provider)
REPLICATE_API_TOKEN=
REPLICATE_API_URL=https://api.replicate.com/v1/predictions
REPLICATE_MODEL_VERSION=0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985
