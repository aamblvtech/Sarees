# SAJEE Platform Environment Configuration
# Safe defaults and placeholder values for production and local development

# 1. NODE.JS BACKEND CONFIGURATION
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://sajee_user:sajee_pass_2026@localhost:5432/sajee_db
JWT_SECRET=sajee_luxury_jwt_secret_drape_your_elegance_2026
JWT_EXPIRES_IN=7d
SESSION_EXPIRY_MINUTES=60
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# 2. AI SERVICE CONFIGURATION
AI_SERVICE_URL=http://localhost:8000
# Provider options: 'mock' (simulation) | 'artcraft' (app.getartcraft.com Omni API) | 'fal' (fal.ai Image Apps v2) | 'replicate' (real cloud IDM-VTON on A100 GPU) | 'idm_vton' (local CUDA)
SAJEE_AI_PROVIDER=mock
ARTCRAFT_API_KEY=artcraft_api_your_key_here
ARTCRAFT_BASE_URL=https://api.storyteller.ai
ARTCRAFT_MODEL=flux_1_schnell
FAL_KEY=your_fal_api_key_here
REPLICATE_API_TOKEN=r8_your_replicate_api_token_here
IDM_VTON_CHECKPOINT_DIR=./checkpoints/idm_vton
GPU_DEVICE_ID=0

# 3. POSTGRES DOCKER CONFIGURATION
POSTGRES_DB=sajee_db
POSTGRES_USER=sajee_user
POSTGRES_PASSWORD=sajee_pass_2026
POSTGRES_PORT=5432

# 4. FRONTEND CONFIGURATION
VITE_API_BASE_URL=http://localhost:5000/api
