# ==============================================================================
# AURA ATELIER - AI Virtual Dressing Room Configuration
# ==============================================================================

# Application Environment & Server Binding
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# ------------------------------------------------------------------------------
# QR Code & Mobile Phone Upload Reachability
# ------------------------------------------------------------------------------
# If left blank or set to localhost, the server automatically resolves your
# local network IP (e.g. http://192.168.1.X:8000) so phones on the same Wi-Fi
# can scan the QR code and upload photos directly.
#
# For access outside your local Wi-Fi, run an HTTPS tunnel (e.g., ngrok or cloudflare)
# and paste the public HTTPS URL here:
# PUBLIC_STORE_URL=https://your-tunnel-name.ngrok-free.app
PUBLIC_STORE_URL=

# ------------------------------------------------------------------------------
# AI Virtual Try-On Provider
# ------------------------------------------------------------------------------
# Options:
#  - "idm-vton"           : Hugging Face ZeroGPU IDM-VTON Cloud Gradio Space
#                           Model: IDM-VTON (Choi et al.)
#                           License: CC BY-NC-SA 4.0 (Non-Commercial / Evaluation only)
#                           Requires: Optional HF_TOKEN from https://huggingface.co/settings/tokens
#
#  - "gemini-nano-banana" : Google Gemini Multimodal Image Generation
#                           Model: gemini-2.5-flash-image / gemini-3.1-flash-image
#                           License: Google Cloud Commercial API Terms (Pay-As-You-Go)
#                           Requires: GEMINI_API_KEY from https://aistudio.google.com with linked billing
#
#  - "fashn"              : FASHN.ai Try-On Max API (Commercial production API)
#                           License: Commercial SaaS API Terms
#                           Requires: FASHN_API_KEY from https://fashn.ai/products/api
#
AI_TRYON_PROVIDER=idm-vton

# Hugging Face Access Token (for IDM-VTON ZeroGPU Space)
# Free tokens get standard ZeroGPU quota; Pro tokens get 25-40 min/day GPU allocation
HF_TOKEN=your_huggingface_token_here

# Google Gemini API Key (for Gemini Nano Banana try-on and Stylist Consultation)
# Image generation requires a Google Cloud project with Pay-As-You-Go billing linked
GEMINI_API_KEY=your_gemini_api_key_here

# FASHN.ai API Key (for commercial Try-On Max API)
FASHN_API_KEY=your_fashn_api_key_here

# ------------------------------------------------------------------------------
# Database & Admin Security
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./virtual_dressing_room.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_123
ADMIN_SECRET_KEY=super_secure_admin_session_jwt_secret_change_me

# ------------------------------------------------------------------------------
# Storage, Privacy & CORS
# ------------------------------------------------------------------------------
# Ephemeral retention time for temporary photos and results (1800s = 30 minutes)
TEMPORARY_RETENTION_SECONDS=1800
MAX_UPLOAD_SIZE_MB=10

# CORS origins (default '*' allows LAN phones and localhost)
CORS_ORIGINS=*
