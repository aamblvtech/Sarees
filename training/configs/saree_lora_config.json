{
  "model_type": "sdxl_inpainting_lora",
  "base_model": "diffusers/stable-diffusion-xl-1.0-inpainting-0.1",
  "vae_model": "diffusers/stable-diffusion-xl-1.0-inpainting-0.1",
  "dataset_manifest": "training/data/dataset_curated.json",
  "output_dir": "training/checkpoints/saree_sdxl_lora_curated_pilot",
  "resolution": 1024,
  "train_batch_size": 1,
  "gradient_accumulation_steps": 1,
  "learning_rate": 1e-4,
