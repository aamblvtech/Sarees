  "lr_warmup_steps": 10,
  "max_train_steps": 20,
  "checkpointing_steps": 10,
  "validation_steps": 10,
  "lora_rank": 32,
  "lora_alpha": 32,
  "lora_target_modules": [
    "to_k",
    "to_q",
    "to_v",
    "to_out.0"
  ],
  "mixed_precision": "fp16",
  "gradient_checkpointing": true,
  "use_8bit_adam": false,
  "seed": 42,
  "snr_gamma": 5.0,
  "garment_conditioning": {
    "type": "ip_adapter_xl",
    "scale": 0.85
  },
  "supported_fabrics": [
    "banarasi_silk",
    "kanchipuram_silk",
    "chiffon_georgette",
    "sheer_organza"
  ],
  "hardware_requirements": {
    "min_vram_gb": 16,
    "target_platform": "Apple Silicon MPS (MacBook M4 16GB) / NVIDIA CUDA",
    "recommended_gpu": "Apple M4 (MPS) or NVIDIA A10G (24GB)"
  }
}
